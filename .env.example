# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (SQLite - file-based, no credentials needed)
DB_PATH=./database/gram_panchayat.db

# Security Keys (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your_jwt_secret_key_change_this_to_random_string
SESSION_SECRET=your_session_secret_change_this_to_random_string

# Frontend URL (for CORS - add your Render frontend URL)
FRONTEND_URL=https://your-app-name.onrender.com

# Email Configuration (Optional - for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# API Base URL (for production deployment)
API_URL=https://your-api-name.onrender.com
